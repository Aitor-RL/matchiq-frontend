{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/inicio",
      "destination": "/index.html"
    },
    {
      "source": "/equipos",
      "destination": "/index.html"
    },
    {
      "source": "/comparador",
      "destination": "/index.html"
    },
    {
      "source": "/equipos/:id",
      "destination": "/index.html"
    },
    {
      "source": "/partidos/:id",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/inicio",
      "permanent": true
    }
  ],
  "trailingSlash": false
}
