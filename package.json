{
  "name": "matchiq-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @matchiq/web dev",
    "build": "pnpm --filter @matchiq/web build && node scripts/prerender.mjs",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm test:seo",
    "brand:build": "node scripts/brand-assets.mjs",
    "preview": "node scripts/preview.mjs",
    "test:seo": "node scripts/seo-check.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.19.0",
    "opentype.js": "1.3.4",
    "sharp": "0.34.5",
    "typescript": "^5.9.3"
  }
}
